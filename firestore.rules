rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validDefinitions() {
      return request.resource.data.keys().hasOnly(['version', 'routines', 'revision'])
        && request.resource.data.version == 1
        && request.resource.data.routines is list
        && request.resource.data.routines.size() > 0
        && request.resource.data.routines.size() <= 20;
    }

    match /users/{uid}/hub/{document} {
      allow read: if owner(uid);

      allow create: if owner(uid) && document == 'routines'
        && validDefinitions()
        && request.resource.data.get('revision', 1) is int
        && request.resource.data.get('revision', 1) == 1;

      // Only the owner edits definitions; revisions reject stale editor saves.
      allow update: if owner(uid) && document == 'routines'
        && validDefinitions()
        && request.resource.data.revision is int
        && request.resource.data.revision <= 1000000000
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;

      allow create, update: if owner(uid) && document == 'progress'
        && request.resource.data.keys().hasOnly(['checks', 'optional'])
        && request.resource.data.checks is map
        && request.resource.data.optional is map
        && request.resource.data.checks.size() <= 24000
        && request.resource.data.optional.size() <= 240
        && request.resource.data.checks.values().hasOnly([true, false])
        && request.resource.data.optional.values().hasOnly([true, false]);
    }
    match /users/{uid}/health/{medicationId} {
      function validLedger() {
        return medicationId.matches('^med-[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['version', 'revision', 'payload'])
          && request.resource.data.version == 1
          && request.resource.data.revision is int
          && request.resource.data.revision <= 1000000000
          && request.resource.data.payload is string
          && request.resource.data.payload.size() > 0
          && request.resource.data.payload.size() <= 450000;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validLedger() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validLedger()
        && request.resource.data.revision == resource.data.revision + 1;
    }

    match /users/{uid}/habits/{id} {
      function count(field) {
        return request.resource.data.get(field, 0) is int
          && request.resource.data.get(field, 0) >= 0
          && request.resource.data.get(field, 0) <= 500;
      }
      function validDay() {
        return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['version', 'cigarettes', 'coffees'])
          && request.resource.data.version == 1
          && count('cigarettes') && count('coffees');
      }
      // Settings always carry all four fields; null means not set yet.
      function validSettings() {
        let data = request.resource.data;
        return id == 'settings'
          && data.keys().hasOnly(['version', 'coffeeCutoff', 'pouchPrice', 'pouchCigarettes', 'baseline'])
          && data.version == 1
          && (data.coffeeCutoff == null || data.coffeeCutoff is string && data.coffeeCutoff.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && (data.pouchPrice == null || data.pouchPrice is number && data.pouchPrice > 0 && data.pouchPrice <= 1000)
          && (data.pouchCigarettes == null || data.pouchCigarettes is int && data.pouchCigarettes >= 1 && data.pouchCigarettes <= 1000)
          && (data.baseline == null || data.baseline is int && data.baseline >= 0 && data.baseline <= 200);
      }
      allow read: if owner(uid);
      allow create, update: if owner(uid) && (validDay() || validSettings());
    }

    match /users/{uid}/habitImports/{importId} {
      function validReceipt() {
        let data = request.resource.data;
        return importId.matches('^[a-f0-9-]{36}$')
          && data.keys().hasOnly(['day', 'cigarettes', 'coffees'])
          && data.day is string && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.cigarettes is int && data.cigarettes >= 0 && data.cigarettes <= 500
          && data.coffees is int && data.coffees >= 0 && data.coffees <= 500;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validReceipt();
      allow update: if owner(uid) && validReceipt() && request.resource.data.day == resource.data.day;
    }

    match /users/{uid}/notes/{noteId} {
      function validNote() {
        return noteId.matches('^[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['version', 'id', 'parent', 'text', 'updatedAt', 'retired'])
          && request.resource.data.version == 1
          && request.resource.data.id == noteId
          && request.resource.data.retired == false
          && request.resource.data.parent is string
          && (request.resource.data.parent == '' || request.resource.data.parent.matches('^[a-f0-9-]{36}$'))
          && request.resource.data.parent != noteId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 50000
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0
          && request.resource.data.updatedAt <= 9007199254740991;
      }
      function retirement() {
        return noteId.matches('^[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['version', 'id', 'retired'])
          && request.resource.data.version == 1 && request.resource.data.id == noteId
          && request.resource.data.retired == true;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && (validNote() || retirement());
      // Retired IDs never become active again; retirement removes all old text.
      allow update: if owner(uid) && (request.resource.data == resource.data || retirement());
    }
    // Unmatched paths and checklist document deletions are denied by default.
  }
}
