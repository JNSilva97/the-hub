rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validDefinitions() {
      return request.resource.data.keys().hasOnly(['version', 'routines', 'revision'])
        && request.resource.data.version == 1
        && request.resource.data.routines is list
        && request.resource.data.routines.size() > 0
        && request.resource.data.routines.size() <= 20;
    }

    match /users/{uid}/hub/{document} {
      allow read: if owner(uid);

      allow create: if owner(uid) && document == 'routines'
        && validDefinitions()
        && request.resource.data.get('revision', 1) is int
        && request.resource.data.get('revision', 1) == 1;

      // Only the owner edits definitions; revisions reject stale editor saves.
      allow update: if owner(uid) && document == 'routines'
        && validDefinitions()
        && request.resource.data.revision is int
        && request.resource.data.revision <= 1000000000
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;

      allow create, update: if owner(uid) && document == 'progress'
        && request.resource.data.keys().hasOnly(['checks', 'optional'])
        && request.resource.data.checks is map
        && request.resource.data.optional is map
        && request.resource.data.checks.size() <= 24000
        && request.resource.data.optional.size() <= 240
        && request.resource.data.checks.values().hasOnly([true, false])
        && request.resource.data.optional.values().hasOnly([true, false]);
    }
    match /users/{uid}/notes/{noteId} {
      function validNote() {
        return noteId.matches('^[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['version', 'id', 'parent', 'text', 'updatedAt', 'retired'])
          && request.resource.data.version == 1
          && request.resource.data.id == noteId
          && request.resource.data.retired == false
          && request.resource.data.parent is string
          && (request.resource.data.parent == '' || request.resource.data.parent.matches('^[a-f0-9-]{36}$'))
          && request.resource.data.parent != noteId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 50000
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0
          && request.resource.data.updatedAt <= 9007199254740991;
      }
      function retirement() {
        return noteId.matches('^[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['version', 'id', 'retired'])
          && request.resource.data.version == 1 && request.resource.data.id == noteId
          && request.resource.data.retired == true;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && (validNote() || retirement());
      // Retired IDs never become active again; retirement removes all old text.
      allow update: if owner(uid) && (request.resource.data == resource.data || retirement());
    }
    // Unmatched paths and checklist document deletions are denied by default.
  }
}
